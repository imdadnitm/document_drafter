<turbo-frame id="template_document">
  <div class="max-w-4xl mr-auto bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden animate-in fade-in duration-300">
    
    <!-- Header with Actions -->
    <div class="px-8 py-6 border-b border-gray-100 flex items-center justify-between bg-gray-50/50">
      <div>
        <h1 class="text-xl font-bold text-gray-900"><%= @template.name %></h1>
        <p class="text-xs text-gray-500 mt-1 font-mono uppercase tracking-tight">Record ID: #<%= @template.id %></p>
      </div>

      <div class="flex items-center gap-3">
        <%= button_to edit_template_path(@template), 
            method: :get,
            class: "flex items-center gap-2 px-4 py-2 bg-white border border-gray-300 rounded-lg text-sm font-semibold text-gray-700 hover:bg-gray-50 transition-all cursor-default shadow-sm" do %>
          <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" stroke-width="2"/></svg>
          Edit
        <% end %>

        <%= button_to @template, 
            method: :delete, 
            data: { turbo_frame: "_top", turbo_confirm: "Are you sure you want to delete this document?" },
            class: "flex items-center gap-2 px-4 py-2 bg-red-50 text-red-600 rounded-lg text-sm font-semibold hover:bg-red-100 transition-all cursor-default" do %>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" stroke-width="2"/></svg>
          Delete
        <% end %>
      </div>
    </div>

    <!-- Content Section: PADDING ADDED HERE (px-8 py-8) -->
    <div id="<%= dom_id @template %>" class="px-8 py-8 space-y-8 animate-in fade-in duration-500">      

      <!-- Middle Section: Placeholder Data -->
      <div class="space-y-4">
        <h3 class="text-xs font-bold text-gray-400 uppercase tracking-widest flex items-center gap-2">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 7v10c0 1.1.9 2 2 2h12a2 2 0 002-2V7M4 7a2 2 0 012-2h12a2 2 0 012 2M4 7h16m-5 4h3m-3 4h3" stroke-width="2"/></svg>
          Extracted Placeholders
        </h3>
        
        <div class="bg-gray-50/50 rounded-2xl p-6 border border-gray-100 shadow-inner">
          <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-y-6 gap-x-4">
            <% JSON.parse(@template.placeholders || '{}').each do |field_name, data_type| %>
              <div class="overflow-hidden">
                <dt class="text-[10px] font-bold text-indigo-500 uppercase truncate mb-1"><%= field_name.humanize %></dt>
                <dd class="text-sm text-gray-900 font-semibold break-words">(<%= data_type.presence || "—" %>)</dd>
              </div>
            <% end %>
          </dl>
        </div>
      </div>

      <!-- Bottom Section: File Download -->
      <% if @template.template_document.attached? %>
        <div class="group flex items-center justify-between p-4 bg-white rounded-xl border border-gray-200 hover:border-indigo-300 transition-all shadow-sm">
          <div class="flex items-center gap-3">
            <div class="p-2.5 bg-indigo-50 rounded-lg group-hover:bg-indigo-600 transition-colors">
              <svg class="w-6 h-6 text-indigo-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z" stroke-width="2"/></svg>
            </div>
            <div class="min-w-0">
              <p class="text-[10px] font-bold text-gray-400 uppercase tracking-tight">Attached Document</p>
              <p class="text-sm font-bold text-gray-800 truncate max-w-[180px] sm:max-w-xs md:max-w-md">
                <%= @template.template_document.filename %>
              </p>
            </div>
          </div>

          <%= link_to rails_blob_path(@template.template_document, disposition: "attachment"), 
              class: "inline-flex items-center gap-2 px-5 py-2 bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold rounded-lg transition-all shadow-md shadow-indigo-100 cursor-default shrink-0",
              target: "_blank" do %>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" stroke-width="2"/></svg>
            Download
          <% end %>
        </div>
      <% end %>
    </div>

    <!-- Footer Meta -->
    <div class="px-8 py-4 bg-gray-50 border-t border-gray-100 flex justify-between items-center text-[10px] uppercase tracking-widest text-gray-400 font-semibold">
      <span>Created <%= (@template.created_at) %></span>
    </div>
  </div>
</turbo-frame>

