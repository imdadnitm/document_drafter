<tr id="<%= dom_id(template) %>" class="hover:bg-indigo-50/30 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-gray-500"><%= template.created_at.strftime("%b %d, %Y  %H:%M") %></td>
                <td class="px-6 py-4 font-mono text-xs text-gray-400">#<%= template.id %></td>
                <td class="px-6 py-4">
                  <%= link_to template.name, template, data: { turbo_frame: "_top" }, class: "font-medium text-indigo-600 hover:text-indigo-900" %>
                </td>
                <td class="px-6 py-4"><%= link_to template.template_document.filename, rails_blob_path(template.template_document, disposition: "attachment"), class:"font-medium text-indigo-600 hover:text-indigo-900", target:"_blank" %></td>
                <td class="px-6 py-4 text-gray-400"><%= (template.updated_at.strftime("%b %d, %Y  %H:%M"))%></td>
              </tr>