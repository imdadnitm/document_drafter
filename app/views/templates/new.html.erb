<% content_for :title, "New Template" %>


<%= turbo_frame_tag "new_template" do %>
  <div class="animate-in fade-in slide-in-from-top-4 duration-300">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-lg font-bold text-gray-900">Create New Template</h1>
      <%# Optional: Add a button to close the frame/cancel %>
      <%= link_to "Cancel", "#", class: "text-xs text-gray-400 hover:text-gray-600", data: { action: "click->placeholders#cancel" } %>
    </div>
    
    <%= render "form", template: @template %>
  </div>
<% end %>