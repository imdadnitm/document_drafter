<tr id=<%=dom_id(generated_document)%> class="hover:bg-gray-50">
    <td class="px-4 py-3"><%= generated_document.created_at %></td>
    <td class="px-4 py-3"><%= generated_document.id%> </td>
    <td class="px-4 py-3 text-sky-600 hover:underline"><%= link_to generated_document.name, generated_document, data:{turbo_frame: "_top"} %></td>
    <td class="px-4 py-3"><%= generated_document.template.name%></td>
    <td class="px-4 py-3"><%= generated_document.updated_at%></td>
</tr>