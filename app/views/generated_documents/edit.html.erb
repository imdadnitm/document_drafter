<turbo-frame id="generated_document">
  <% content_for :title, "Editing #{@generated_document.name}" %>

  <div class="max-w-4xl mx-auto bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden animate-in fade-in duration-300">
    
    <!-- Header -->
    <div class="px-8 py-6 border-b border-gray-100 flex items-center justify-between bg-indigo-50/30">
      <div>
        <h1 class="text-xl font-bold text-gray-900">Edit Settings</h1>
        <p class="text-xs text-indigo-600 font-medium mt-1">You are currently modifying this record</p>
      </div>
      
      <%= button_to "Discard Changes", @generated_document, 
          method: :get,
          class: "text-sm font-medium text-gray-400 hover:text-gray-600 transition-colors cursor-default" %>
    </div>

    <div class="p-8">
      <%= render "form", generated_document: @generated_document %>
    </div>
  </div>
</turbo-frame>

