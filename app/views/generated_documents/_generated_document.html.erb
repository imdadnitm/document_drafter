<div id="<%= dom_id generated_document %>">
  <p>
    <strong>Name:</strong>
    <%= generated_document.name %>
  </p>

  <p>
    <strong>Placeholder inputs:</strong>
    <%= generated_document.placeholder_inputs %>
  </p>

  <p>
    <strong>Template:</strong>
    <%= generated_document.template_id %>
  </p>

  <p>
  <% if @generated_document&.file&.attached? %>
     <p> <strong>Generated file/document :</strong> <%= link_to @generated_document.file.filename, rails_blob_path(@generated_document.file, disposition: "attachment"), target: "_blank" %></p>
    <% end %>
  </p>

</div>
