<turbo-frame id="index" class="block">
  <% content_for :title, "Generated Documents" %>

  <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8">
    
    <!-- Table Section -->
    <div>
      <div class="flex-1 min-w-0 bg-white rounded-2xl shadow-sm border border-gray-200 overflow-hidden">
        <div class="p-6 border-b flex justify-between items-center bg-white">
          <h1 class="text-xl font-bold text-gray-900">Generated Documents</h1>
          <span class="px-3 py-1 bg-gray-100 text-gray-600 text-xs rounded-full font-medium">
            <%= @generated_documents.count %> Total
          </span>
        </div>
  
        <div class="overflow-x-auto">
          <table id="dataTable" class="w-full text-sm text-left border-collapse">
            <thead class="bg-gray-50 border-b border-gray-200 sticky top-0">
              <tr class="text-gray-500 uppercase text-[11px] tracking-wider">
                <th class="px-6 py-3 font-semibold">Created</th>
                <th class="px-6 py-3 font-semibold">ID</th>
                <th class="px-6 py-3 font-semibold">Name</th>
                <th class="px-6 py-3 font-semibold">Template</th>
                <th class="px-6 py-3 font-semibold">Updated</th>
              </tr>
              <tr class="bg-white border-b">
                <% 5.times do |i| %>
                  <th class="px-4 py-2">
                    <input data-col="<%= i %>" placeholder="Filter..." 
                           class="w-full border-gray-200 rounded-md px-2 py-1 text-xs focus:ring-indigo-500 focus:border-indigo-500 filter-input" />
                  </th>
                <% end %>
              </tr>
            </thead>
  
            <tbody id="gen_doc_tbody" class="divide-y divide-gray-100">
              <% @generated_documents.each do |doc| %>
                <tr id="<%= dom_id(doc) %>" class="hover:bg-indigo-50/30 transition-colors">
                  <td class="px-6 py-4 whitespace-nowrap text-gray-500"><%= doc.created_at.strftime("%b %d, %Y  %H:%M") %></td>
                  <td class="px-6 py-4 font-mono text-xs text-gray-400">#<%= doc.id %></td>
                  <td class="px-6 py-4">
                    <%= link_to doc.name, doc, data: { turbo_frame: "_top" }, class: "font-medium text-indigo-600 hover:text-indigo-900" %>
                  </td>
                  <td class="px-6 py-4 text-gray-600"><%= doc.template.name %></td>
                  <td class="px-6 py-4 text-gray-400"><%= (doc.updated_at.strftime("%b %d, %Y  %H:%M"))%></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>  
      <div class= "flex justify-center mt-4">
         <%== @pagy.series_nav %>
      </div>
    </div>  

    <!-- Action Section -->
    <div class="w-full lg:w-80 shrink-0 space-y-4">
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-200">
        <%= button_to new_generated_document_path, method: :get, 
            data: { turbo_frame: "new_document" },
            class: "w-full flex items-center justify-center gap-2 bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-xl transition-all shadow-sm shadow-indigo-200" do %>
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 4v16m8-8H4" stroke-width="2" stroke-linecap="round"/></svg>
          New Document
        <% end %>

        <%= turbo_frame_tag "new_document", class: "mt-6 block empty:hidden" %>
      </div>
    </div>
  </div>
</turbo-frame>