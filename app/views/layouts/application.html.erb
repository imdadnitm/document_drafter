<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Gen Doc" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

<body class="h-screen bg-gray-50 overflow-hidden">
  <% if user_signed_in? && !current_page?(edit_user_registration_path) %>
    <div class="flex h-full">
      <!-- Sidebar -->
      <aside class="w-64 bg-white border-r border-gray-200 flex flex-col shrink-0">
        <div class="p-6 border-b border-gray-200">
          <div class="h-10 rounded-lg bg-gray-100 flex items-center justify-center text-sm font-semibold">Logo</div>
        </div>

        <nav class="flex-1 p-4 space-y-1 overflow-y-auto", data-controller="sidebar">
          <%= link_to "Generated Documents", generated_documents_path, data:{turbo_frame:"index", sidebar_target:"generated_doc_item", action:"click->sidebar#nav_item_css_change"}, class: "block rounded-lg px-4 py-2 text-sm font-medium "+ highlighted_class("/generated_documents") %>
          <%= link_to "Templates", templates_path, data:{turbo_frame:"index", sidebar_target:"template_item", action:"click->sidebar#nav_item_css_change"}, class: "block rounded-lg px-4 py-2 text-sm font-medium"+ highlighted_class("/templates") %>
          
          <details class="group mt-4">
             <summary class="flex cursor-pointer items-center justify-between rounded-lg px-4 py-2 text-sm font-medium list-none">
               Account
               <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path d="M19 9l-7 7-7-7" stroke-width="2"/></svg>
             </summary>
             <div class="mt-2 space-y-1 px-2">
                 <!--<%= link_to "Edit Profile", edit_user_registration_path, data:{sidebar_target:"user_account", action:"click->sidebar#nav_item_css_change"}, class: "block rounded-lg px-4 py-2 text-sm text-gray-600 hover:bg-gray-100" %>-->
                 <%= link_to "Edit Profile", edit_user_registration_path, class: "block rounded-lg px-4 py-2 text-sm text-gray-600 hover:bg-gray-100" %>
                 <%= link_to "Logout", destroy_user_session_path, data: { turbo_method: :delete }, class: "block rounded-lg px-4 py-2 text-sm text-red-600 hover:bg-red-50" %>
             </div>
          </details>
        </nav>

        <div class="border-t border-gray-200 p-4 text-xs text-gray-500 truncate">
          <%= current_user.email %>
        </div>
      </aside>

      <!-- Main Content Area -->
      <main class="flex-1 flex flex-col min-w-0 overflow-hidden">
        
        <div class="flex-1 overflow-y-auto p-8">
          <%= yield %>
        </div>
      </main>
    </div>
  <% else %>
    <%= yield %>
  <% end %>
</body>

</html>
