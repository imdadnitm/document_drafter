<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Gen Doc" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

<body class="h-screen bg-gray-50">

  <% if user_signed_in? %>

  <!-- Layout wrapper -->
  <div class="flex h-full">

    <!-- Sidebar -->
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col">

      <!-- Logo -->
      <div class="p-6 border-b border-gray-200 ">
        <div class="h-10 rounded-lg bg-gray-100 flex items-center justify-center text-sm font-semibold">
          Logo
        </div>
      </div>

      <!-- Menu -->
      <nav class="flex-1 p-4 space-y-1 overflow-y-auto">

        <%= link_to "Generated Documents", generated_documents_path, data: {turbo_action: "replace"}, class: "block rounded-lg bg-gray-100 px-4 py-2 text-sm font-medium text-gray-700" %>
        <%= link_to "Templates", templates_path, data: {turbo_action: "replace"}, class: "block rounded-lg px-4 py-2 text-sm font-medium text-gray-500 hover:bg-gray-100 hover:text-gray-700" %>

        <details class="group mt-4">
             <summary class="flex cursor-pointer items-center justify-between px-4 py-2 text-xs font-semibold text-gray-400 uppercase list-none hover:text-gray-600">
               Account
               <svg xmlns="http://www.w3.org/2000/svg"
                    class="w-4 h-4 transition-transform group-open:rotate-180"
                    fill="none" viewBox="0 0 24 24" stroke="currentColor">
                 <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
               </svg>
           
             </summary>
             <div class="mt-2 space-y-1 px-2">
                 <%= link_to "Edit Profile", edit_user_registration_path, class: "block rounded-lg px-4 py-2 text-sm text-gray-600 hover:bg-gray-100" %>
                 <%= link_to "Logout", destroy_user_session_path, data: {turbo_method: :delete}, class: "block rounded-lg px-4 py-2 text-sm text-red-600 hover:bg-red-50" %>
             </div>
        </details>


      </nav>

      <!-- Bottom user info -->
      <div class="border-t border-gray-200 p-4 text-xs text-gray-500">
        <%= current_user.email %>
      </div>
    </aside>

    <% end%>
    
    <div>
      <p class = "notice"><%= notice %></p>
      <p class = "alert"><%= alert %></p>
      <%= yield %>  
      </div>
  </body>
</html>
